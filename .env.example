# Supabase — new API keys system (2025)
NEXT_PUBLIC_SUPABASE_URL=

# Public key, safe for the browser. New format: sb_publishable_...
# (replaces the legacy anon JWT key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key. New format: sb_secret_...
# (replaces the legacy service_role key). Wired in Step 2 for the client
# bootstrap rollback and admin user creation. NEVER prefix with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Runware, y son dos llaves a propósito.
#
# RUNWARE_API_KEY la leen los scripts de Python de herramientas/, y vive acá
# desde los experimentos. La app NO la lee: tenerla no significa querer gastar.
RUNWARE_API_KEY=

# API_KEY_RUNWARE_PROD es la de la app, y es lo único que decide si genera de
# verdad. Vacía = simulador, gratis, y la pantalla lo dice. Con valor, cada
# generación se cobra. Existe separada para que correr un experimento no
# encienda el gasto de la app sin que nadie lo haya decidido.
API_KEY_RUNWARE_PROD=