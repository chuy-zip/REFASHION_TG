# Supabase — new API keys system (2025)
NEXT_PUBLIC_SUPABASE_URL=

# Public key, safe for the browser. New format: sb_publishable_...
# (replaces the legacy anon JWT key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key. New format: sb_secret_...
# (replaces the legacy service_role key). Wired in Step 2 for the client
# bootstrap rollback and admin user creation. NEVER prefix with NEXT_PUBLIC.
SUPABASE_SECRET_KEY=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
